{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "rootDir": "../src/renderer",
    // Drops the ambient `chrome` and `node` types the extension compiles against, so this emit stops
    // compiling the day the renderer stops being standalone rather than shipping a package that
    // needs them.
    "types": []
  },
  // The self-checks are repo infrastructure and the only files here allowed to import `node:*` and
  // `typescript`, so they are the one thing the package must not carry.
  "include": ["../src/renderer/**/*.ts"],
  "exclude": ["../src/renderer/**/*.selfcheck.ts", "../src/renderer/selfcheck/**"]
}
